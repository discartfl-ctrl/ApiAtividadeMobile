 * AUTENTICAÇÃO
 * ============================================================
 */

/**
 * Cria um token temporário.
 */
function criarToken(email) {
  const token = uuidv4();

  const criadoEm = Date.now();

  const expiracao = criadoEm + CONFIG.tokenExpiracaoHoras * 60 * 60 * 1000;

  tokens.set(token, {
    email,
    criadoEm,
    expiracao,
  });

  return token;
}

/**
 * Remove tokens expirados.
 */
function limparTokensExpirados() {
  const agora = Date.now();

  for (const [token, dados] of tokens.entries()) {
    if (dados.expiracao <= agora) {
      tokens.delete(token);
    }
  }
}

/**
 * Obtém o token do cabeçalho Authorization.
 */
function obterToken(req) {
  const authorization = req.headers.authorization;

  if (!authorization) {
    return null;
  }

  const partes = authorization.split(' ');

  if (partes.length !== 2) {
    return null;
  }

  if (partes[0].toLowerCase() !== 'bearer') {
    return null;
  }

  return partes[1];
}

/**
 * Middleware de autenticação.
 */
function autenticar(req, res, next) {
  limparTokensExpirados();

  const token = obterToken(req);

  if (!token) {
    return respostaErro(
      res,
      401,
      'Token de autenticação não informado.'
    );
  }

  const sessao = tokens.get(token);

  if (!sessao) {
    return respostaErro(
      res,
      401,
      'Token inválido ou expirado.'
    );
  }

  req.usuario = {
    email: sessao.email,
  };

  next();
}

/*
 * ============================================================
 * FUNÇÕES DE FILTRO E ORDENAÇÃO
 * ============================================================
 */

/**
 * Filtra jogos pelo nome.
 */
function filtrarPorNome(lista, nome) {
  if (valorVazio(nome)) {
    return lista;
  }

  const termo = String(nome).toLowerCase().trim();

  return lista.filter((jogo) =>
    jogo.nome.toLowerCase().includes(termo)
  );
}

/**
 * Filtra jogos pelo tipo.
 */
function filtrarPorTipo(lista, tipo) {
  if (valorVazio(tipo)) {
    return lista;
  }

  const termo = String(tipo).toLowerCase().trim();

  return lista.filter((jogo) =>
    jogo.tipo.toLowerCase().includes(termo)
  );
}

/**
 * Filtra jogos pela nota mínima.
 */
function filtrarPorNotaMinima(lista, nota) {
  if (nota === undefined) {
    return lista;
  }

  const numero = paraNumero(nota);

  if (numero === null) {
    return [];
  }

  return lista.filter((jogo) => jogo.nota >= numero);
}

/**
 * Filtra jogos pela nota máxima.
 */
function filtrarPorNotaMaxima(lista, nota) {
  if (nota === undefined) {
    return lista;
  }

  const numero = paraNumero(nota);

  if (numero === null) {
    return [];
  }

  return lista.filter((jogo) => jogo.nota <= numero);
}

/**
 * Ordena uma lista de jogos.
 */
function ordenarJogos(lista, campo, ordem) {
  const resultado = [...lista];

  const direcao = ordem === 'desc' ? -1 : 1;

  resultado.sort((a, b) => {
    if (campo === 'nome') {
      return a.nome.localeCompare(b.nome) * direcao;
    }

    if (campo === 'tipo') {
      return a.tipo.localeCompare(b.tipo) * direcao;
    }

    if (campo === 'nota') {
      return (a.nota - b.nota) * direcao;
    }

    if (campo === 'id') {
      return (a.id - b.id) * direcao;
    }

    return a.id - b.id;
  });

  return resultado;
}

/**
 * Aplica todos os filtros.
 */
function aplicarFiltros(lista, query) {
  let resultado = [...lista];

  resultado = filtrarPorNome(resultado, query.nome);
  resultado = filtrarPorTipo(resultado, query.tipo);
  resultado = filtrarPorNotaMinima(resultado, query.notaMin);
  resultado = filtrarPorNotaMaxima(resultado, query.notaMax);

  return resultado;
}

/**
 * Aplica paginação.
 */
function aplicarPaginacao(lista, pagina, limite) {
  const total = lista.length;

  const totalPaginas =
    total === 0 ? 0 : Math.ceil(total / limite);

  const paginaAtual =
    pagina > 0 ? Math.min(pagina, Math.max(totalPaginas, 1)) : 1;

  const inicio = (paginaAtual - 1) * limite;

  const dados = lista.slice(inicio, inicio + limite);

  return {
    dados,
    paginacao: {
      pagina: paginaAtual,
      limite,
      total,
      totalPaginas,
      temProxima: paginaAtual < totalPaginas,
      temAnterior: paginaAtual > 1,
    },
  };
}

/*
 * ============================================================
 * ESTATÍSTICAS
 * ============================================================
 */

/**
 * Calcula a média das notas.
 */
function calcularMedia(lista) {
  if (lista.length === 0) {
    return 0;
  }

  const soma = lista.reduce(
    (total, jogo) => total + jogo.nota,
    0
  );

  return Number((soma / lista.length).toFixed(2));
}

/**
 * Encontra o jogo com maior nota.
 */
function encontrarMelhorJogo(lista) {
  if (lista.length === 0) {
    return null;
  }

  return lista.reduce((melhor, atual) => {
    return atual.nota > melhor.nota ? atual : melhor;
  });
}

/**
 * Encontra o jogo com menor nota.
 */
function encontrarPiorJogo(lista) {
  if (lista.length === 0) {
    return null;
  }

  return lista.reduce((pior, atual) => {
    return atual.nota < pior.nota ? atual : pior;
  });
}

/**
 * Conta jogos por categoria.
 */
function contarPorTipo(lista) {
  const categorias = {};

  lista.forEach((jogo) => {
    if (!categorias[jogo.tipo]) {
      categorias[jogo.tipo] = 0;
    }

    categorias[jogo.tipo]++;
  });

  return categorias;
}

