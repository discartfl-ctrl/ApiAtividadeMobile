/**
 * Verifica se um valor está vazio.
 */
function valorVazio(valor) {
  return (
    valor === undefined ||
    valor === null ||
    (typeof valor === 'string' && valor.trim() === '')
  );
}

/**
 * Converte um valor para texto.
 */
function paraTexto(valor, valorPadrao = '') {
  if (valor === undefined || valor === null) {
    return valorPadrao;
  }

  return String(valor).trim();
}

/**
 * Converte um valor para número.
 */
function paraNumero(valor) {
  if (valor === undefined || valor === null || valor === '') {
    return null;
  }

  const numero = Number(valor);

  if (!Number.isFinite(numero)) {
    return null;
  }

  return numero;
}

/**
 * Converte um ID para número inteiro.
 */
function converterId(valor) {
  const numero = Number(valor);

  if (!Number.isInteger(numero) || numero <= 0) {
    return null;
  }

  return numero;
}

/**
 * Gera o próximo ID disponível.
 */
function gerarProximoId() {
  if (jogos.length === 0) {
    return 1;
  }

  const ids = jogos
    .map((jogo) => jogo.id)
    .filter((id) => Number.isInteger(id))
    .sort((a, b) => a - b);

  let proximoId = 1;

  for (const id of ids) {
    if (id === proximoId) {
      proximoId++;
      continue;
    }

    if (id > proximoId) {
      break;
    }
  }

  return proximoId;
}

/**
 * Procura um jogo pelo ID.
 */
function encontrarJogoPorId(id) {
  return jogos.find((jogo) => jogo.id === id);
}

/**
 * Procura o índice de um jogo.
 */
function encontrarIndicePorId(id) {
  return jogos.findIndex((jogo) => jogo.id === id);
}

/**
 * Cria uma resposta de erro padronizada.
 */
function respostaErro(res, status, mensagem, detalhes = null) {
  const resposta = {
    success: false,
    error: mensagem,
  };

  if (detalhes) {
    resposta.details = detalhes;
  }

  return res.status(status).json(resposta);
}

/**
 * Cria uma resposta de sucesso padronizada.
 */
function respostaSucesso(res, status, dados) {
  return res.status(status).json({
    success: true,
    data: dados,
  });
}

