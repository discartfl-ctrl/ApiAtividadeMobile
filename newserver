    maiorNota:
      jogos.length > 0
        ? Math.max(...jogos.map((jogo) => jogo.nota))
        : 0,
    menorNota:
      jogos.length > 0
        ? Math.min(...jogos.map((jogo) => jogo.nota))
        : 0,
    melhorJogo,
    piorJogo,
    jogosPorTipo: contarPorTipo(jogos),
  };

  return respostaSucesso(
    res,
    200,
    estatisticas
  );
});

/*
 * ============================================================
 * GET /tipos
 * ============================================================
 */

app.get('/tipos', (req, res) => {
  const tipos = [
    ...new Set(
      jogos.map((jogo) => jogo.tipo)
    ),
  ].sort((a, b) => a.localeCompare(b));

  return respostaSucesso(
    res,
    200,
    {
      total: tipos.length,
      tipos,
    }
  );
});

/*
 * ============================================================
 * GET /melhores-jogos
 * ============================================================
 */

app.get('/melhores-jogos', (req, res) => {
  const quantidade = Number(
    req.query.quantidade || 5
  );

  const limite =
    Number.isInteger(quantidade) &&
    quantidade > 0
      ? Math.min(quantidade, 20)
      : 5;

  const melhores = [...jogos]
    .sort((a, b) => {
      if (b.nota !== a.nota) {
        return b.nota - a.nota;
      }

      return a.nome.localeCompare(b.nome);
    })
    .slice(0, limite);

  return respostaSucesso(
    res,
    200,
    melhores
  );
});

/*
 * ============================================================
 * GET /jogos/tipo/:tipo
 * ============================================================
 */

app.get('/jogos/tipo/:tipo', (req, res) => {
  const tipo = paraTexto(
    req.params.tipo
  ).toLowerCase();

  if (!tipo) {
    return respostaErro(
      res,
      400,
      'O tipo do jogo é obrigatório.'
    );
  }

  const encontrados = jogos.filter(
    (jogo) =>
      jogo.tipo.toLowerCase() === tipo
  );

  return respostaSucesso(
    res,
    200,
    encontrados
  );
});

