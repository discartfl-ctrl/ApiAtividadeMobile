/**
 * Valida o nome do jogo.
 */
function validarNome(nome) {
  const erros = [];

  if (valorVazio(nome)) {
    erros.push('O campo "nome" é obrigatório.');
    return erros;
  }

  if (typeof nome !== 'string') {
    erros.push('O campo "nome" deve ser texto.');
    return erros;
  }

  const nomeLimpo = nome.trim();

  if (nomeLimpo.length < 2) {
    erros.push('O nome deve possuir pelo menos 2 caracteres.');
  }

  if (nomeLimpo.length > 100) {
    erros.push('O nome deve possuir no máximo 100 caracteres.');
  }

  return erros;
}

/**
 * Valida o tipo do jogo.
 */
function validarTipo(tipo) {
  const erros = [];

  if (tipo === undefined || tipo === null || tipo === '') {
    return erros;
  }

  if (typeof tipo !== 'string') {
    erros.push('O campo "tipo" deve ser texto.');
    return erros;
  }

  if (tipo.trim().length > 50) {
    erros.push('O tipo deve possuir no máximo 50 caracteres.');
  }

  return erros;
}

/**
 * Valida a nota.
 */
function validarNota(nota) {
  const erros = [];

  if (nota === undefined || nota === null || nota === '') {
    return erros;
  }

  const numero = paraNumero(nota);

  if (numero === null) {
    erros.push('O campo "nota" deve ser um número.');
    return erros;
  }

  if (numero < CONFIG.notaMinima || numero > CONFIG.notaMaxima) {
    erros.push(
      `O campo "nota" deve estar entre ${CONFIG.notaMinima} e ${CONFIG.notaMaxima}.`
    );
  }

  return erros;
}

/**
 * Valida a review.
 */
function validarReview(review) {
  const erros = [];

  if (review === undefined || review === null || review === '') {
    return erros;
  }

  if (typeof review !== 'string') {
    erros.push('O campo "review" deve ser texto.');
    return erros;
  }

  if (review.trim().length > 500) {
    erros.push('A review deve possuir no máximo 500 caracteres.');
  }

  return erros;
}

/**
 * Valida um jogo completo.
 */
function validarJogo(dados, parcial = false) {
  const erros = [];

  if (!parcial || dados.nome !== undefined) {
    erros.push(...validarNome(dados.nome));
  }

  if (dados.tipo !== undefined) {
    erros.push(...validarTipo(dados.tipo));
  }

  if (dados.nota !== undefined) {
    erros.push(...validarNota(dados.nota));
  }

  if (dados.review !== undefined) {
    erros.push(...validarReview(dados.review));
  }

  return erros;
}

/**
 * Valida o corpo da requisição.
 */
function validarCorpoObjeto(req, res, next) {
  if (
    req.body === null ||
    req.body === undefined ||
    Array.isArray(req.body) ||
    typeof req.body !== 'object'
  ) {
    return respostaErro(
      res,
      400,
      'O corpo da requisição deve ser um objeto JSON.'
    );
  }

  next();
}

/*
