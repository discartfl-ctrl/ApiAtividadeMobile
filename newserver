 * GET /jogos/:id
 * ============================================================
 */

app.get('/jogos/:id', (req, res) => {
  const id = converterId(req.params.id);

  if (id === null) {
    return respostaErro(
      res,
      400,
      'ID deve ser um número inteiro positivo.'
    );
  }

  const jogo = encontrarJogoPorId(id);

  if (!jogo) {
    return respostaErro(
      res,
      404,
      'Jogo não encontrado.'
    );
  }

  return respostaSucesso(res, 200, jogo);
});

/*
 * ============================================================
 * POST /jogos
 * ============================================================
 */

app.post(
  '/jogos',
  autenticar,
  validarCorpoObjeto,
  (req, res) => {
    const {
      nome,
      tipo,
      nota,
      review,
    } = req.body ?? {};

    const erros = validarJogo({
      nome,
      tipo,
      nota,
      review,
    });

    if (erros.length > 0) {
      return respostaErro(
        res,
        400,
        'Existem dados inválidos.',
        erros
      );
    }

    const novoJogo = {
      id: gerarProximoId(),
      nome: paraTexto(nome),
      tipo: paraTexto(tipo, 'Indefinido'),
      nota:
        nota === undefined || nota === null || nota === ''
          ? 0
          : Number(nota),
      review: paraTexto(review),
    };

    jogos.push(novoJogo);

    return respostaSucesso(
      res,
      201,
      novoJogo
    );
  }
);

/*
 * ============================================================
 * PUT /jogos/:id
 * ============================================================
 */

app.put(
  '/jogos/:id',
  autenticar,
  validarCorpoObjeto,
  (req, res) => {
    const id = converterId(req.params.id);

    if (id === null) {
      return respostaErro(
        res,
        400,
        'ID deve ser um número inteiro positivo.'
      );
    }

    const index = encontrarIndicePorId(id);

    if (index === -1) {
      return respostaErro(
        res,
        404,
        'Jogo não encontrado.'
      );
    }

    const jogoAtual = jogos[index];

    const dadosAtualizados = {
      nome:
        req.body.nome !== undefined
          ? req.body.nome
          : jogoAtual.nome,

      tipo:
        req.body.tipo !== undefined
          ? req.body.tipo
          : jogoAtual.tipo,

      nota:
        req.body.nota !== undefined
          ? req.body.nota
          : jogoAtual.nota,

      review:
        req.body.review !== undefined
          ? req.body.review
          : jogoAtual.review,
    };

    const erros = validarJogo(
      dadosAtualizados,
      true
    );

    if (erros.length > 0) {
      return respostaErro(
        res,
        400,
        'Existem dados inválidos.',
        erros
      );
    }

    jogos[index] = {
      id,
      nome: paraTexto(dadosAtualizados.nome),
      tipo: paraTexto(
        dadosAtualizados.tipo,
        'Indefinido'
      ),
      nota: Number(dadosAtualizados.nota),
      review: paraTexto(
        dadosAtualizados.review
      ),
    };

    return respostaSucesso(
      res,
      200,
      jogos[index]
    );
  }
);

/*
 * ============================================================
 * PATCH /jogos/:id
 * ============================================================
 */

app.patch(
  '/jogos/:id',
  autenticar,
  validarCorpoObjeto,
  (req, res) => {
    const id = converterId(req.params.id);

    if (id === null) {
      return respostaErro(
        res,
        400,
        'ID deve ser um número inteiro positivo.'
      );
    }

    const index = encontrarIndicePorId(id);

    if (index === -1) {
      return respostaErro(
        res,
        404,
        'Jogo não encontrado.'
      );
    }

    const camposPermitidos = [
      'nome',
      'tipo',
      'nota',
      'review',
    ];

    const camposRecebidos = Object.keys(req.body);

    const camposInvalidos = camposRecebidos.filter(
      (campo) => !camposPermitidos.includes(campo)
    );

    if (camposInvalidos.length > 0) {
      return respostaErro(
        res,
        400,
        'Existem campos não permitidos.',
        camposInvalidos
      );
    }

    const jogoAtual = jogos[index];

    const jogoAtualizado = {
      ...jogoAtual,
    };

    if (req.body.nome !== undefined) {
      jogoAtualizado.nome = paraTexto(
        req.body.nome
      );
    }

    if (req.body.tipo !== undefined) {
      jogoAtualizado.tipo = paraTexto(
        req.body.tipo,
        'Indefinido'
      );
    }

    if (req.body.nota !== undefined) {
      jogoAtualizado.nota = Number(
        req.body.nota
      );
    }

    if (req.body.review !== undefined) {
      jogoAtualizado.review = paraTexto(
        req.body.review
      );
    }

    const erros = validarJogo(
      jogoAtualizado,
      false
    );

    if (erros.length > 0) {
      return respostaErro(
        res,
        400,
        'Existem dados inválidos.',
        erros
      );
    }

    jogos[index] = jogoAtualizado;

    return respostaSucesso(
      res,
      200,
      jogos[index]
    );
  }
);

/*
 * ============================================================
 * DELETE /jogos/:id
 * ============================================================
 */

app.delete(
  '/jogos/:id',
  autenticar,
  (req, res) => {
    const id = converterId(req.params.id);

    if (id === null) {
      return respostaErro(
        res,
        400,
        'ID deve ser um número inteiro positivo.'
      );
    }

    const index = encontrarIndicePorId(id);

    if (index === -1) {
      return respostaErro(
        res,
        404,
        'Jogo não encontrado.'
      );
    }

    const jogoRemovido = jogos[index];

    jogos.splice(index, 1);

    return respostaSucesso(
      res,
      200,
      {
        message: 'Jogo removido com sucesso.',
        jogo: jogoRemovido,
      }
    );
  }
);

