  });
});

/*
 * ============================================================
 * GET /jogos
 * ============================================================
 */

app.get('/jogos', (req, res) => {
  const {
    nome,
    tipo,
    notaMin,
    notaMax,
    ordenar = 'id',
    ordem = 'asc',
    pagina = 1,
    limite = CONFIG.limitePadrao,
  } = req.query;

  let paginaNumero = Number(pagina);
  let limiteNumero = Number(limite);

  if (!Number.isInteger(paginaNumero) || paginaNumero < 1) {
    paginaNumero = 1;
  }

  if (!Number.isInteger(limiteNumero) || limiteNumero < 1) {
    limiteNumero = CONFIG.limitePadrao;
  }

  limiteNumero = Math.min(
    limiteNumero,
    CONFIG.limiteMaximo
  );

  const jogosFiltrados = aplicarFiltros(jogos, {
    nome,
    tipo,
    notaMin,
    notaMax,
  });

  const jogosOrdenados = ordenarJogos(
    jogosFiltrados,
    ordenar,
    ordem
  );

  const resultado = aplicarPaginacao(
    jogosOrdenados,
    paginaNumero,
    limiteNumero
  );

  return res.status(200).json({
    success: true,
    data: resultado.dados,
    paginacao: resultado.paginacao,
    filtros: {
      nome: nome || null,
      tipo: tipo || null,
      notaMin: notaMin || null,
      notaMax: notaMax || null,
      ordenar,
      ordem,
    },
  });
});

/*
