/*
 * ============================================================
 * TRATAMENTO DE ERROS
 * ============================================================
 */

app.use((err, req, res, next) => {
  console.error(
    '[ERRO INTERNO]',
    err
  );

  if (res.headersSent) {
    return next(err);
  }

  return respostaErro(
    res,
    500,
    'Erro interno do servidor.'
  );
});

/*
 * ============================================================
 * TRATAMENTO DE JSON INVÁLIDO
 * ============================================================
 */

app.use(
  (
    err,
    req,
    res,
    next
  ) => {
    if (
      err instanceof SyntaxError &&
      err.status === 400 &&
      'body' in err
    ) {
      return respostaErro(
        res,
        400,
        'JSON inválido.'
      );
    }

    next(err);
  }
);

