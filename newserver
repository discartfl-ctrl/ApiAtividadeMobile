app.post('/login', (req, res) => {
  const { email, password } = req.body ?? {};

  if (valorVazio(email) || valorVazio(password)) {
    return respostaErro(
      res,
      400,
      'Email e senha são obrigatórios.'
    );
  }

  if (typeof email !== 'string') {
    return respostaErro(
      res,
      400,
      'O email deve ser informado como texto.'
    );
  }

  if (typeof password !== 'string') {
    return respostaErro(
      res,
      400,
      'A senha deve ser informada como texto.'
    );
  }

  if (
    email.trim() !== USUARIO.email ||
    password !== USUARIO.password
  ) {
    return respostaErro(
      res,
      401,
      'Credenciais inválidas.'
    );
  }

  const token = criarToken(email.trim());

  return respostaSucesso(res, 200, {
    token,
    tokenType: 'Bearer',
    expiresIn: `${CONFIG.tokenExpiracaoHoras} horas`,
    user: {
      email: email.trim(),
    },
  });
});

